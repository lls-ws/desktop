# Profile para o transmission-daemon
#include <tunables/global>

/usr/bin/transmission-daemon flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/user-download>

  # Permissões de rede
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,

  # Executável e bibliotecas
  /usr/bin/transmission-daemon mr,

  # Arquivos de configuração e logs do sistema
  /etc/transmission-daemon/ r,
  /etc/transmission-daemon/** r,
  /var/log/transmission/ r,
  /var/log/transmission/** rw,

  # Diretório padrão de dados e downloads do sistema
  /var/lib/transmission-daemon/ r,
  /var/lib/transmission-daemon/** rwk,
  
  # Permite ler, gravar e criar arquivos na pasta e subpastas de downloads
  /home/torrents/ r,
  /home/torrents/** rwk,
  
  # Permite ler, listar, gravar e criar arquivos na pasta de filmes
  /home/shared/filmes/ r,
  /home/shared/filmes/** rwk,
  
  # Permite ler, listar, gravar e criar arquivos na pasta de log
  /home/shared/log/ r,
  /home/shared/log/** rwk,

  # Permite ler a pasta e ler/executar qualquer script dentro da pasta scripts
  /var/lib/transmission-daemon/scripts/ r,
  /var/lib/transmission-daemon/scripts/* ix,
  
  # Permissão para o systemd notify
  /run/systemd/notify w,

  # Acesso à interface web (HTML/JS)
  /usr/share/transmission/ r,
  /usr/share/transmission/** r,

  # Permissões para ler configurações locais e temporários
  /run/transmission-daemon.pid rwk,
  
  # Permite leitura, escrita e criação na pasta de configurações do sistema
  /var/lib/transmission-daemon/.config/ r,
  /var/lib/transmission-daemon/.config/** rwk,

  # Garante a compatibilidade com a variável HOME do daemon
  owner @{HOME}/.config/ r,
  owner @{HOME}/.config/** rwk,
  
}
