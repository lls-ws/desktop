# Profile para o transmission-daemon
#include <tunables/global>

/usr/bin/transmission-daemon flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/user-download>

  # Permissões de rede
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,

  # Executável e bibliotecas
  /usr/bin/transmission-daemon mr,

  # Arquivos de configuração e logs do sistema
  /etc/transmission-daemon/ r,
  /etc/transmission-daemon/** r,
  /var/log/transmission/ r,
  /var/log/transmission/** rw,

  # Diretório padrão de dados e downloads do sistema
  /var/lib/transmission-daemon/ rw,
  /var/lib/transmission-daemon/** rwk,
  
  # Permissão para o Transmission ler e executar scripts desta pasta
  /var/lib/transmission-daemon/scripts/ rw,
  /var/lib/transmission-daemon/scripts/** rwkix,
  
  # Permissões para a nova pasta de downloads customizada
  /home/torrents/ rw,
  /home/torrents/** rwk,
  
  # Permissões para ler e listar a pasta compartilhada de filmes
  /home/shared/filmes/ rw,
  /home/shared/filmes/** rwk,
  /home/shared/log/ rw,
  /home/shared/log/** rwk,
  
  # Permissão para o systemd notify
  /run/systemd/notify w,
  
  # Permite executar comandos comuns do sistema dentro de scripts
  #include <abstractions/bash>
  /bin/date ix,
  /usr/bin/date ix,
  /bin/find ix,
  /usr/bin/find ix,
  /bin/chown ix,
  /usr/bin/chown ix,
  /bin/du ix,
  /usr/bin/du ix,
  /bin/cat ix,
  /usr/bin/cat ix,
  /bin/curl ix,
  /usr/bin/curl ix,
  /bin/basename ix,
  /usr/bin/basename ix,
  /usr/share/awk ix,
  /usr/bin/awk ix,

  # Acesso à interface web (HTML/JS)
  /usr/share/transmission/ r,
  /usr/share/transmission/** r,

  # Permissões para ler configurações locais e temporários
  /run/transmission-daemon.pid rwk,
  owner @{HOME}/.config/transmission-daemon/ rw,
  owner @{HOME}/.config/transmission-daemon/** rwk,
  /var/lib/transmission-daemon/.config/transmission-daemon/ rw,
  /var/lib/transmission-daemon/.config/transmission-daemon/** rwk,
  
}
