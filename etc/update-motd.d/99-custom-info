#!/bin/bash
if [ "$(hostname)" = "dell" ]; then
    echo "=================================================="
    echo " Último Reboot: $(last reboot | head -n 1 | awk '{print $5, $6, $7, $8}')"
    echo " Tempo Atividade: $(uptime -p)"
    echo " Espaço Disponível: $(df -h /home | awk 'NR==2 {print $4}')"
    echo "=================================================="
fi
