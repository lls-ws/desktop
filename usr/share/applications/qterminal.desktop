[Desktop Entry]
Type=Application
Icon=utilities-terminal
Exec=bash -c "COLOR_SCHEME='DarkPastels'; sed -i \"s/^colorScheme=.*/colorScheme=\${COLOR_SCHEME}/\" \"/home/\${USER}/.config/qterminal.org/qterminal.ini\" && qterminal"
Terminal=false
Categories=Qt;System;TerminalEmulator;
Actions=Dropdown;

Name[pt_BR]=Terminal
GenericName[pt_BR]=Emulador de Terminal
Comment[pt_BR]=Emulador de Terminal
